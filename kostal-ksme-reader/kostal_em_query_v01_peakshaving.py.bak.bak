if __name__ == "__main__":  
    while(1==1):
        #time.sleep(1.0)
        #print ("Starting QUERY .......... ")
        try:
            Kostalvalues =[]
            Kostalquery = kostal_em_query()
            Kostalquery.run()
        except Exception as ex:
            print ("Issues querying Kostal Plenticore -ERROR :", ex)
        result=""
        for elements in Kostalquery.KostalRegister:
            #print ( elements[0], elements[1], elements[2], elements[3])
            result=result+str(elements[3])+";"
        f = open("/media/ramdisk/kostal.txt", "w")
        f.write(result)
        f.close()

        #open and read the file after the appending:
        f = open("/media/ramdisk/kostal.txt", "r")
