            self.Adr17[3]=self.ReadU32(self.Adr17[0])
            self.Adr18[3]=self.ReadU32(self.Adr18[0])
            self.Adr19[3]=self.ReadU32(self.Adr19[0])
            self.Adr20[3]=self.ReadU32(self.Adr20[0])
            self.Adr21[3]=self.ReadU32(self.Adr21[0])
            self.Adr22[3]=self.ReadU32(self.Adr22[0])
            self.Adr23[3]=self.ReadU32(self.Adr23[0])
            self.Adr24[3]=self.ReadU32(self.Adr24[0])
            self.Adr25[3]=self.ReadU32(self.Adr25[0])
            self.Adr26[3]=self.ReadU32(self.Adr26[0])
            now = datetime.now().time()
            peak_shaving=0 #Amper pro Phase bevor es los geht
            sicherung=35
            L1_A=self.ReadU32(self.Adr6[0])/1000
            if L1_A < peak_shaving:
                L1_A=0
            else:
                L1_A=L1_A-peak_shaving
            print("L1_A "+str(L1_A))
            L1_V=200+self.ReadU32(self.Adr7[0])/1000
            #print("L1_V "+str(L1_V))
            L2_A=self.ReadU32(self.Adr15[0])/1000
            if L2_A < peak_shaving:
                L2_A=0
            else:
                L2_A=L2_A-peak_shaving
            print("L2_A "+str(L2_A))
            L2_V=200+self.ReadU32(self.Adr16[0])/1000
            L3_A=self.ReadU32(self.Adr24[0])/1000
            if L3_A < peak_shaving:
                L3_A=0
            else:
                L3_A=L3_A-peak_shaving
            print("L3_A "+str(L3_A))
            L3_V=200+self.ReadU32(self.Adr25[0])/1000
            L1_W=L1_A*L1_V
            L2_W=L2_A*L2_V
            L3_W=L3_A*L2_V
            W_max=max([L1_W,L2_W,L3_W])
            W_sum=(L1_W+L2_W+L3_W)*10
            if now >= datetime.strptime("01:00", "%H:%M").time() and now <= datetime.strptime("03:00", "%H:%M").time() or now >= datetime.strptime("12:00", "%H:%M").time() and now <= datetime.strptime("14:00", "%H:%M").time():
                if L1_A < sicherung and L2_A < sicherung and L3_A < sicherung:
                    value=min([(sicherung-L1_A)*L1_V,(sicherung-L2_A)*L2_V,(sicherung-L3_A)*L3_V])
                    print("Sicherung hat Luft "+str(value))
                else:
                    value=-max([(L1_A-sicherung)*L1_V,(L2_A-sicherung)*L2_V,(L3_A-sicherung)*L3_V])
                    print("Sicherung hat keine Luft "+str(value))
                print(value)
                if value < 0: #wenn negativ, dann Sicherung überschritten
                    self.Adr27[3]=int(value)*-30
                    self.Adr28[3]=0
                    print("Sicherung überschritten "+str(value))
                else:
                    self.Adr27[3]=0
                    self.Adr28[3]=int(value)*30
                    print("Sicherung geht's gut "+str(value))
            else:
                print(W_sum)
                self.Adr27[3]=self.ReadU32(self.Adr27[0])
                self.Adr28[3]=self.ReadU32(self.Adr28[0])
            self.Adr29[3]=self.ReadU32(self.Adr29[0])
            self.Adr30[3]=self.ReadU32(self.Adr30[0])
            self.Adr31[3]=self.ReadU32(self.Adr31[0])
            self.Adr32[3]=self.ReadU32(self.Adr32[0])
            self.Adr33[3]=self.ReadU32(self.Adr33[0])
            self.Adr34[3]=self.ReadU32(self.Adr34[0])

            #self.Adr8192[3]=self.ReadU16_1(self.Adr8192[0])
            #print("read success")
            self.KostalRegister=[]
            self.KostalRegister.append(self.Adr0)
            self.KostalRegister.append(self.Adr1)
            self.KostalRegister.append(self.Adr2)
            self.KostalRegister.append(self.Adr3)
