            self.KostalRegister.append(self.Adr8)
            self.KostalRegister.append(self.Adr9)
            self.KostalRegister.append(self.Adr10)
            self.KostalRegister.append(self.Adr11)
            self.KostalRegister.append(self.Adr12)
            self.KostalRegister.append(self.Adr13)
            self.KostalRegister.append(self.Adr14)
            self.KostalRegister.append(self.Adr15)
            self.KostalRegister.append(self.Adr16)
            self.KostalRegister.append(self.Adr17)
            self.KostalRegister.append(self.Adr18)
            self.KostalRegister.append(self.Adr19)
            self.KostalRegister.append(self.Adr20)
            self.KostalRegister.append(self.Adr21)
            self.KostalRegister.append(self.Adr22)
            self.KostalRegister.append(self.Adr23)
            self.KostalRegister.append(self.Adr24)
            self.KostalRegister.append(self.Adr25)
            self.KostalRegister.append(self.Adr26)
            self.KostalRegister.append(self.Adr27)
            self.KostalRegister.append(self.Adr28)
            self.KostalRegister.append(self.Adr29)
            self.KostalRegister.append(self.Adr30)
            self.KostalRegister.append(self.Adr31)
            self.KostalRegister.append(self.Adr32)
            self.KostalRegister.append(self.Adr33)
            self.KostalRegister.append(self.Adr34)

            #self.KostalRegister.append(self.Adr8192)
            
            self.client.close()


    except Exception as ex:
            print ("XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX")
            print ("XXX- Hit the following error :From subroutine kostal_em_query :", ex)
            print ("XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX")
